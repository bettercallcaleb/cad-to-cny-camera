<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <org.ramgpt.cad2cnycam.PriceOverlayView
        android:id="@+id/priceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#66000000"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/waiting_for_price"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ocrDebugText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#E6222222"
            android:fontFamily="monospace"
            android:maxLines="5"
            android:padding="8dp"
            android:textColor="@color/scanner_green"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/controlsToggle"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:minHeight="0dp"
            android:text="@string/settings"
            android:textColor="@color/white"
            app:backgroundTint="#99000000" />

        <LinearLayout
            android:id="@+id/controlsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#D9000000"
            android:padding="8dp"
            android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/taxModeButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tax_mode_auto"
            android:textColor="@color/white" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/debugOcrSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_ocr"
            android:textColor="@color/white"
            app:showText="false" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/tiledOcrSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tiled_ocr"
            android:textColor="@color/white"
            app:showText="false" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/replaceModeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/replace_mode"
            android:textColor="@color/white"
            app:showText="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rateButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:strokeColor="@color/scanner_green"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aboutPrivacyButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_privacy"
            android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
